# ──────────────────────────────────────────────────────────────
#  CaféGo – Environment variables
#  Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#  All variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle.
#  For EAS Build, register them with: eas env:create
# ──────────────────────────────────────────────────────────────

# Firebase – Project settings > General > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# OTP / Email verification services
EXPO_PUBLIC_ACCOUNT_OTP_API_URL=https://your-account-otp-service.example.com
EXPO_PUBLIC_PASSWORD_RESET_API_URL=https://your-password-reset-service.example.com

